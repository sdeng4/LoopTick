# PostgreSQL (Supabase) connection string
DATABASE_URL=postgresql://user:password@host:5432/postgres
API_PORT=3001

# Signs login sessions (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public URL of the site, used in email links (no trailing slash)
APP_URL=http://localhost:5173

# SMTP for verification and countdown emails.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = a Google "App password".
# If SMTP_HOST is empty, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LoopTick <you@example.com>"

# Vercel only: call GET /api/cron/notify every minute with the header
#   Authorization: Bearer <CRON_SECRET>
# from an external scheduler such as cron-job.org.
CRON_SECRET=
